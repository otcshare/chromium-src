Subject: [PATCH] [IE] Add ngraph sigmoid op for testing

---
 services/ml/compilation_delegate_ie.cc | 94 +++++++++-----------------
 services/ml/compilation_delegate_ie.h  | 21 +++++-
 services/ml/execution_impl_ie.cc       | 18 ++++-
 3 files changed, 68 insertions(+), 65 deletions(-)

diff --git a/services/ml/compilation_delegate_ie.cc b/services/ml/compilation_delegate_ie.cc
index 0b02c5bd5860..96097e19869a 100644
--- a/services/ml/compilation_delegate_ie.cc
+++ b/services/ml/compilation_delegate_ie.cc
@@ -14,10 +14,16 @@
 #include "third_party/libinference_engine/dldt/inference-engine/include/ie_builders.hpp"
 #include "third_party/libinference_engine/dldt/inference-engine/include/inference_engine.hpp"
 
+#include "third_party/libinference_engine/dldt/ngraph/src/ngraph/opsets/opset.hpp"
+#include "third_party/libinference_engine/dldt/ngraph/src/ngraph/opsets/opset1.hpp"
