--- a/services/ml/compilation_delegate_ie.h
+++ b/services/ml/compilation_delegate_ie.h
@@ -23,6 +23,19 @@ class Network;
 }
 }  // namespace InferenceEngine
 
+namespace ngraph {
+// ParameterVector;
+// ResultVector;
+class Function;
+class Node;
