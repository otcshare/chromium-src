// https://github.com/webmachinelearning/model-loader/blob/main/explainer.md

[
  SecureContext,
  RuntimeEnabled=MachineLearning
] interface MLModelLoaded {
  [CallWith=ScriptState] Promise<record<DOMString, MLTensor>>
      compute(record<DOMString, MLTensor> inputs);
};
