// https://github.com/webmachinelearning/model-loader/blob/main/explainer.md

// This is different with the specification of WebNN because in the first
// version we do not involve any hardware acceleration.
typedef ArrayBufferView MLBufferView;

// This is different with the specification of WebNN because in the first
// version we do not involve any hardware acceleration.
typedef MLBufferView MLResource;

dictionary MLInput {
  required MLResource resource;
  required sequence<long> dimensions;
};
