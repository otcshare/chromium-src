// https://github.com/webmachinelearning/model-loader/blob/main/explainer.md

[
  RuntimeEnabled=MachineLearning,
  Exposed=Window
] interface MLModelLoader {
  [CallWith=ScriptState, RaisesException] constructor(MLContext context);

  [CallWith=ScriptState, RaisesException] Promise<MLModelLoaded>
      load(ArrayBuffer buffer, MLLoadModelOptions options);
};
